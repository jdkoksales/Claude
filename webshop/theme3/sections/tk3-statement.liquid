{{ 'tk3.css' | asset_url | stylesheet_tag }}

<div class="tk3">
  <section class="statement">
    <div class="wrap">
      <p><b>{{ section.settings.lead }}</b> {{ section.settings.rest }}</p>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "TK3 statement",
  "settings": [
    { "type": "text", "id": "lead", "label": "Vette zin", "default": "Reviews bepalen wie er binnenkomt." },
    { "type": "textarea", "id": "rest", "label": "Vervolg", "default": "76% van de consumenten leest ze altijd of vaak voordat ze een lokale zaak kiest." }
  ],
  "presets": [{ "name": "TK3 statement" }]
}
{% endschema %}
