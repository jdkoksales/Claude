{{ 'tk3.css' | asset_url | stylesheet_tag }}

<div class="tk3">
  <section class="blk grey">
    <div class="wrap">
      <div class="story">
        {%- if section.settings.image -%}
          <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | escape }}" width="1000" height="1000" loading="lazy">
        {%- else -%}
          <img src="{{ 'tk3-story.jpg' | asset_url }}" alt="{{ shop.name }}" width="1000" height="1000" loading="lazy">
        {%- endif -%}
        <div class="txt">
          <h2>{{ section.settings.heading }}</h2>
          <h3>{{ section.settings.sub }}</h3>
          {{ section.settings.body }}
          <div class="sig">
            <img src="{{ 'tk3-logo.svg' | asset_url }}" alt="{{ shop.name }}" width="600" height="85" style="height:24px;width:auto;display:block">
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "TK3 verhaal",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Het verhaal." },
    { "type": "text", "id": "sub", "label": "Onderkop", "default": "Waarom we dit maken." },
    { "type": "richtext", "id": "body", "label": "Tekst", "default": "<p>[PLAATSHOUDER — vertel hier in een paar alinea's waarom je TapKaarten bent begonnen. Wat viel je op bij ondernemers? Wat wilde je oplossen?]</p><p>[PLAATSHOUDER — tweede alinea. Wat maakt jullie aanpak anders? Waar sta je voor?]</p><p>[PLAATSHOUDER — afsluiter met een blik vooruit.]</p>" }
  ],
  "presets": [{ "name": "TK3 verhaal" }]
}
{% endschema %}
