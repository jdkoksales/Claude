# Kopieer dit bestand naar .env, of laat `npm run setup` het invullen.

# ─── Vrijwel verplicht ───────────────────────────────────────────────────
# Geheim voor het ondertekenen van sessiecookies. Zonder deze waarde moeten
# jullie na elke herstart van de server opnieuw inloggen.
SESSION_SECRET=

# ─── Push-meldingen (optioneel, maar dan werken herinneringen niet) ──────
# Maak dit paar aan met `npm run setup`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:jij@example.com
# Tijdstip van het dagelijkse overzicht van openstaande doelen (UU:MM).
DAILY_DIGEST_AT=20:00

# ─── Overig ─────────────────────────────────────────────────────────────
# Tijdzone waarin "vandaag" wordt bepaald.
TIMEZONE=Europe/Amsterdam
# Poort waarop de app luistert.
PORT=3000
# Waar de gegevens worden opgeslagen. Bij online hosten: op een schijf die
# blijft bestaan tussen herstarts (zie README).
DB_FILE=data/samen.json
# Hoe lang je ingelogd blijft, in dagen.
SESSION_DAYS=90
# Achter https (bij een hostingdienst) hoort dit aan te staan.
SECURE_COOKIES=true
