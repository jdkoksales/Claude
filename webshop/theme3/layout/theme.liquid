<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      tk3: Inter Variable staat als thema-asset, dus geen externe CDN en geen
      flits van een verkeerd lettertype.
    {% endcomment %}
    <link rel="preload" href="{{ 'tk3-inter.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <style>
      @font-face{font-family:"Inter var";font-weight:100 900;font-display:swap;font-style:normal;
        src:url("{{ 'tk3-inter.woff2' | asset_url }}") format("woff2-variations")}
    </style>

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    <meta name="format-detection" content="telephone=no, email=no, address=no">

    {% comment %}
      Google toont alleen een favicon als die vierkant is en minstens 48px
      meet; het merkteken zelf is breder dan hoog en werd daarom genegeerd.
      Vandaar een apart vierkant icoon, in twee maten zodat zowel de
      zoekresultaten als het tabblad iets scherps te pakken hebben.
    {% endcomment %}
    {% if settings.favicon %}
      <link rel="icon" type="image/png" sizes="192x192" href="{{ settings.favicon | image_url: width: 192, height: 192 }}">
      <link rel="icon" type="image/png" sizes="48x48" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {% else %}
      <link rel="icon" type="image/png" sizes="192x192" href="{{ 'tk3-merk-vierkant.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="48x48" href="{{ 'tk3-favicon-48.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'tk3-merk-vierkant.png' | asset_url }}">
    {% endif %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}
    {{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
    {{ 'tk3.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    {% render 'cart-drawer' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <button
      type="button"
      class="back-to-top"
      aria-label="Back to top"
      data-back-to-top
      hidden
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <polyline points="18 15 12 9 6 15"/>
      </svg>
    </button>

    <script>
      (function() {
        var btn = document.querySelector('[data-back-to-top]');
        if (!btn) return;
        btn.hidden = false;
        var THRESHOLD = 400;
        function onScroll() {
          btn.classList.toggle('is-visible', window.scrollY > THRESHOLD);
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        btn.addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>

    <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
    <script src="{{ 'tk3.js' | asset_url }}" defer></script>
  </body>
</html>
