# ─── Slack ───────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
# Channel/DM id where the coach posts proactive check-ins.
# Tip: open a DM with your bot, or a private channel, and copy the id (starts with D or C).
SLACK_COACH_CHANNEL=

# ─── Anthropic (Claude) ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key
# Cheap + fast model for everyday chat and tasks:
CLAUDE_MODEL=claude-sonnet-4-6
# More capable model for the deeper coaching moments:
CLAUDE_COACH_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=1500
# Let Claude search the web (Anthropic server-side tool, billed per use):
CLAUDE_WEB_SEARCH=true
# Optional: override the assistant/coach persona (leave empty for the default).
CLAUDE_PERSONA=

# ─── Coach scheduling ────────────────────────────────────
COACH_ENABLED=true
COACH_TIMEZONE=Europe/Amsterdam
COACH_MORNING_CRON=0 8 * * *
COACH_EVENING_CRON=0 20 * * *
COACH_WEEKLY_CRON=0 19 * * 0

# ─── Storage ─────────────────────────────────────────────
DB_FILE=data/assistant.db

# ─── Google (optional: Calendar + Gmail) ─────────────────
# Leave empty to disable. See README for how to obtain these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
