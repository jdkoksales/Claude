{{ 'tk3.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign shots = 'google-wit,instagram,facebook' | split: ','
  assign alts = 'Google Review-standaard,Instagram-standaard,Facebook-standaard' | split: ','
  assign gid = section.id | replace: '_', '' | replace: '-', '' 
-%}

<div class="tk3">
  <section class="hero" data-tk3-hero>
    <div class="inner">
      <div class="wrap">
        <h1>{{ section.settings.heading }}</h1>
        {%- if section.settings.sub != blank -%}
          <p class="sub">{{ section.settings.sub }}</p>
        {%- endif -%}

        <div class="controls">
          <div class="seg" role="tablist" aria-label="Platform">
            <button type="button" role="tab" aria-selected="true" title="Google" data-plat="google"
              {% if section.settings.product_google != blank %}data-url="{{ all_products[section.settings.product_google].url }}"{% endif %}>
              <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6z"/><path fill="#34A853" d="M12 23.5c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3a11.5 11.5 0 0 0 10.2 6.3z"/><path fill="#FBBC05" d="M5.6 14.2a6.9 6.9 0 0 1 0-4.4v-3H1.8a11.5 11.5 0 0 0 0 10.4l3.8-3z"/><path fill="#EA4335" d="M12 5.1c1.7 0 3.2.6 4.4 1.7l3.3-3.3A11.5 11.5 0 0 0 1.8 6.8l3.8 3c.9-2.7 3.4-4.7 6.4-4.7z"/></svg>
              <i class="vonk" aria-hidden="true">⭐</i><i class="vonk vonk-b" aria-hidden="true">⭐</i>
            </button>
            <button type="button" role="tab" aria-selected="false" title="Instagram" data-plat="instagram"
              {% if section.settings.product_instagram != blank %}data-url="{{ all_products[section.settings.product_instagram].url }}"{% endif %}>
              <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true">
                <defs><linearGradient id="ig{{ gid }}" x1="0" y1="1" x2="1" y2="0">
                  <stop offset="0" stop-color="#FEDA75"/><stop offset=".28" stop-color="#FA7E1E"/>
                  <stop offset=".6" stop-color="#D62976"/><stop offset=".85" stop-color="#962FBF"/>
                  <stop offset="1" stop-color="#4F5BD5"/></linearGradient></defs>
                <rect x="2" y="2" width="20" height="20" rx="6" fill="url(#ig{{ gid }})"/>
                <circle cx="12" cy="12" r="4.4" fill="none" stroke="#fff" stroke-width="1.9"/>
                <circle cx="17.4" cy="6.6" r="1.25" fill="#fff"/>
              </svg>
              <i class="vonk" aria-hidden="true">❤️</i><i class="vonk vonk-b" aria-hidden="true">❤️</i>
            </button>
            <button type="button" role="tab" aria-selected="false" title="Facebook" data-plat="facebook"
              {% if section.settings.product_facebook != blank %}data-url="{{ all_products[section.settings.product_facebook].url }}"{% endif %}>
              <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="10" fill="#1877F2"/>
                <path fill="#fff" d="M15.6 15.1 16 12h-3v-2c0-.9.4-1.7 1.8-1.7H16V5.6s-1.2-.2-2.3-.2c-2.4 0-3.9 1.4-3.9 4V12H7v3.1h2.8V22a10 10 0 0 0 3.2 0v-6.9h2.6z"/>
              </svg>
              <i class="vonk" aria-hidden="true">👍</i><i class="vonk vonk-b" aria-hidden="true">👍</i>
            </button>
          </div>


          <a class="buy" href="{{ section.settings.cta_url | default: '#producten' }}" data-tk3-buy>{{ section.settings.cta_text }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>

        {%- comment -%}
          Tweede, zachtere ingang: wie nog niet wil kopen maar wel wil weten
          wat het oplevert, gaat naar de rekenhulp. Bewust een link en geen
          knop, zodat hij niet met Kopen concurreert.
        {%- endcomment -%}
        {%- if section.settings.calc_text != blank -%}
          <a class="hero-calc" href="{{ section.settings.calc_url | default: '#calculator' }}">
            <span>{{ section.settings.calc_text }}</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
          </a>
        {%- endif -%}
      </div>

      <div class="shots">
        {%- for key in shots -%}
          <img data-shot="{{ key }}"{% if forloop.first %} class="on"{% endif %}
            src="{{ 'tk3-hero-' | append: key | append: '.png' | asset_url }}"
            alt="{{ alts[forloop.index0] }}" width="1600" height="900"
            {% unless forloop.first %}loading="lazy"{% endunless %}>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "TK3 hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Je beste marketing staat op de balie." },
    { "type": "textarea", "id": "sub", "label": "Onderkop", "default": "Eén tik met de telefoon en je klant staat op jouw Google-, Instagram- of Facebookpagina. Zonder dat jij erom hoeft te vragen." },
    { "type": "text", "id": "cta_text", "label": "Knop", "default": "Kopen" },
    { "type": "url", "id": "cta_url", "label": "Knoplink (als er geen product gekoppeld is)" },
    { "type": "text", "id": "calc_text", "label": "Tweede regel onder de knoppen", "default": "Bereken wat TapKaarten jou oplevert." },
    { "type": "url", "id": "calc_url", "label": "Link van die regel" },
    { "type": "header", "content": "Knop koppelen per platform" },
    { "type": "product", "id": "product_google", "label": "Google" },
    { "type": "product", "id": "product_instagram", "label": "Instagram" },
    { "type": "product", "id": "product_facebook", "label": "Facebook" }
  ],
  "presets": [{ "name": "TK3 hero" }]
}
{% endschema %}
