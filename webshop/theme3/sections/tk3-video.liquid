{{ 'tk3.css' | asset_url | stylesheet_tag }}

{%- assign rail_id = 'tk3-video-' | append: section.id -%}

<div class="tk3">
  <section class="blk grey">
    <div class="wrap">
      <h2 class="sec-title center">{{ section.settings.heading }}</h2>
      {%- if section.settings.sub != blank -%}
        <p class="sec-sub center" style="margin-bottom:44px">{{ section.settings.sub }}</p>
      {%- endif -%}

      <div class="rail" id="{{ rail_id }}">
        {%- for block in section.blocks -%}
          <div class="vcard" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 640 }}" alt="" width="640" height="800" loading="lazy">
            {%- else -%}
              <img src="{{ 'tk3-ph-1.jpg' | file_url }}" alt="" width="640" height="800" loading="lazy">
            {%- endif -%}
            <div class="play">▶</div>
            <div class="cap">{{ block.settings.caption }}</div>
          </div>
        {%- endfor -%}
      </div>

      <div class="arrows">
        <button type="button" onclick="tk3ScrollRail('{{ rail_id }}',-1)" aria-label="Vorige">←</button>
        <button type="button" onclick="tk3ScrollRail('{{ rail_id }}',1)" aria-label="Volgende">→</button>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "TK3 videoverhalen",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Zij vertellen het het best ❤️" },
    { "type": "textarea", "id": "sub", "label": "Onderkop", "default": "Ondernemers die TapKaarten dagelijks gebruiken en zien hoe hun reviews vanzelf binnenkomen." }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "video",
      "name": "Kaart",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Stilstaand beeld" },
        { "type": "text", "id": "caption", "label": "Bijschrift", "default": "Zaaknaam" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TK3 videoverhalen",
      "blocks": [
        { "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
