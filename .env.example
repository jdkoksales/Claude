# ─── Verplicht ───────────────────────────────────────────
# Je Anthropic API-sleutel (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-jouw-key
# De pincode waarmee je de app opent (4-6 cijfers, kies zelf iets)
APP_PIN=4821

# ─── Optioneel ───────────────────────────────────────────
# Je voornaam, voor de begroeting ("Goedemorgen, Julian!")
USER_NAME=
# Poort waarop de app draait
PORT=3000

# Model voor dagelijkse chat (snel + goedkoop):
CLAUDE_MODEL=claude-sonnet-4-6
# Model voor de diepere coachmomenten:
CLAUDE_COACH_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=1500
# Web-zoeken door de coach aan/uit:
CLAUDE_WEB_SEARCH=true
# Eigen persona voor de coach (leeg = ingebouwde standaard):
CLAUDE_PERSONA=

# ─── Check-ins van de coach ──────────────────────────────
COACH_ENABLED=true
COACH_TIMEZONE=Europe/Amsterdam
COACH_MORNING_CRON=0 8 * * *
COACH_EVENING_CRON=0 20 * * *
COACH_WEEKLY_CRON=0 19 * * 0

# ─── Opslag ──────────────────────────────────────────────
DB_FILE=data/coach.json

# ─── Google (optioneel: Agenda + Gmail) ──────────────────
# Leeg laten = uit. Zie README voor het verkrijgen van deze waarden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
