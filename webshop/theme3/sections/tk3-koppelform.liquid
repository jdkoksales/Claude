{{ 'tk3.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Het koppelformulier draait op Shopify's eigen contactformulier. Dat scheelt
  een externe dienst: de inzending komt binnen op het e-mailadres onder
  Instellingen → Meldingen → Klantenservice, en alles wat hier als
  contact[…] meegestuurd wordt staat gewoon in die mail.
{%- endcomment -%}

<div class="tk3">
  <section class="blk koppel">
    <div class="wrap">
      <div class="koppel-kop">
        <p class="koppel-eyebrow">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>
        {%- if section.settings.sub != blank -%}
          <p class="lead">{{ section.settings.sub }}</p>
        {%- endif -%}
      </div>

      <div class="koppel-vak">
        {%- form 'contact', class: 'koppel-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="koppel-gelukt">
              <strong>Bedankt — je gegevens zijn binnen.</strong><br>
              Wij zoeken je pagina’s op en koppelen ze aan je kaarten. Hoor je binnen één werkdag
              niets, mail dan even naar
              <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>.
            </p>
          {%- else -%}
            {%- if form.errors -%}
              <p class="koppel-fout">
                {{ form.errors | default_errors }}
              </p>
            {%- endif -%}

            <div class="koppel-rij">
              <p>
                <label for="koppel-naam">Je naam</label>
                <input type="text" id="koppel-naam" name="contact[name]" required
                  value="{{ form.name }}" autocomplete="name">
              </p>
              <p>
                <label for="koppel-mail">E-mailadres van je bestelling</label>
                <input type="email" id="koppel-mail" name="contact[email]" required
                  value="{{ form.email }}" autocomplete="email" spellcheck="false">
              </p>
            </div>

            <div class="koppel-rij">
              <p>
                <label for="koppel-order">Ordernummer</label>
                <input type="text" id="koppel-order" name="contact[Ordernummer]"
                  placeholder="#1042" autocomplete="off">
                <small>Staat bovenaan je bestelbevestiging. Weet je het niet? Laat het leeg.</small>
              </p>
              <p>
                <label for="koppel-bedrijf">Bedrijfsnaam</label>
                <input type="text" id="koppel-bedrijf" name="contact[Bedrijfsnaam]" required
                  placeholder="Café de Klok" autocomplete="organization">
              </p>
            </div>

            <p>
              <label for="koppel-plaats">Plaats</label>
              <input type="text" id="koppel-plaats" name="contact[Plaats]" required
                placeholder="Roden" autocomplete="address-level2">
              <small>Met je bedrijfsnaam en je plaats vinden wij je Google-bedrijfsprofiel. Heb je meerdere vestigingen of een naam die vaker voorkomt? Zet het adres er dan bij.</small>
            </p>

            <div class="koppel-scheiding"><span>Welke pagina’s moeten er op de kaarten?</span></div>

            <p>
              <label for="koppel-google">Google-bedrijfsprofiel</label>
              <input type="text" id="koppel-google" name="contact[Google]"
                placeholder="Laat leeg als je naam en plaats kloppen" spellcheck="false">
              <small>Alleen invullen als je zaak op Google anders heet dan hierboven.</small>
            </p>
            <p>
              <label for="koppel-insta">Instagram van je zaak</label>
              <input type="text" id="koppel-insta" name="contact[Instagram]"
                placeholder="@jouwzaak" spellcheck="false" autocapitalize="off">
            </p>
            <p>
              <label for="koppel-fb">Facebook van je zaak</label>
              <input type="text" id="koppel-fb" name="contact[Facebook]"
                placeholder="Naam van je bedrijfspagina" spellcheck="false" autocapitalize="off">
              <small>Vul deze twee ook in als je nu alleen een Google-kaart hebt. Dan kunnen wij een kaart later omzetten zonder dat je iets hoeft op te zoeken.</small>
            </p>
            <p>
              <label for="koppel-verdeling">Welke kaart krijgt welke pagina?</label>
              <textarea id="koppel-verdeling" name="contact[body]" rows="3"
                placeholder="Bijvoorbeeld: de twee Google-standaards op de bar, de Instagram-standaard bij de kassa."></textarea>
              <small>Bestel je één soort? Dan mag dit leeg — wij koppelen ze allemaal aan dezelfde pagina.</small>
            </p>

            <button type="submit" class="btn-primary koppel-knop">Versturen</button>
            <p class="koppel-klein">
              Wij gebruiken deze gegevens alleen om je kaarten te programmeren. Zie de
              <a href="/policies/privacy-policy">privacyverklaring</a>.
            </p>
          {%- endif -%}
        {%- endform -%}

        {%- comment -%}
          Instagram en Facebook zijn met opzet niet verplicht: wie alleen een
          Google-kaart koopt heeft ze soms niet, en dan wordt er "nvt" ingetypt
          en zijn we niets opgeschoten. Maar leeg laten is meestal overslaan,
          niet "ik heb er geen". Deze vraag onderscheidt die twee. Zonder
          JavaScript verstuurt het formulier gewoon, dus niemand loopt vast.
        {%- endcomment -%}
        <script>
          (function () {
            var form = document.querySelector('.koppel-form');
            if (!form) return;
            var insta = form.querySelector('#koppel-insta');
            var fb = form.querySelector('#koppel-fb');
            if (!insta || !fb) return;
            var gevraagd = false;
            form.addEventListener('submit', function (e) {
              if (gevraagd || insta.value.trim() || fb.value.trim()) return;
              e.preventDefault();
              gevraagd = true;
              if (window.confirm('Je hebt geen Instagram of Facebook ingevuld.\n\nHeb je die echt niet? Klik op OK om zo te versturen. Klik op Annuleren om ze alsnog in te vullen.')) {
                form.submit();
              } else {
                insta.focus();
              }
            });
          }());
        </script>
      </div>

      {%- if section.settings.pdf_url != blank -%}
        <div class="koppel-pdf">
          <div>
            <h3>Liever zelf instellen?</h3>
            <p>In de handleiding staat hoe je een kaart met de gratis app NFC Tools in ongeveer twee minuten naar een andere pagina laat wijzen. Onbeperkt, zo vaak je wilt.</p>
          </div>
          <a class="btn-secondary" href="{{ section.settings.pdf_url }}" target="_blank" rel="noopener">
            Handleiding (pdf)
          </a>
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "TK3 koppelformulier",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Na je bestelling" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Geef je pagina’s door, wij koppelen ze" },
    { "type": "textarea", "id": "sub", "label": "Onderkop", "default": "Vul hieronder in hoe je zaak heet, in welke plaats je zit en hoe je op Instagram en Facebook heet. Wij zoeken de pagina’s op en zetten ze op je kaarten voordat ze de deur uit gaan." },
    { "type": "text", "id": "email", "label": "Contactadres", "default": "info@tapkaarten.nl" },
    { "type": "url", "id": "pdf_url", "label": "Link naar de handleiding (pdf)" }
  ],
  "presets": [{ "name": "TK3 koppelformulier" }]
}
{% endschema %}
