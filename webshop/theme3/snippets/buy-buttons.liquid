<div class="product-info__buy-buttons" data-buy-buttons>
  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

  {%- comment -%}
    Staffelkorting. De percentages hieronder moeten gelijk lopen met de drie
    automatische kortingen in Shopify; die doen het echte rekenwerk in de
    winkelwagen. Klikken op een trede vult het aantal alvast in.
  {%- endcomment -%}
  {%- assign eenheid = current_variant.price -%}
  <div class="tk3-staffel" data-tk3-staffel>
    <div class="tk3-staffel-kop">Meer kaarten, meer korting</div>
    <div class="tk3-staffel-rij">
      {%- assign treden = '1,2,3,4' | split: ',' -%}
      {%- for trede in treden -%}
        {%- assign aantal = trede | plus: 0 -%}
        {%- case aantal -%}
          {%- when 2 -%}{%- assign pct = 10 -%}
          {%- when 3 -%}{%- assign pct = 15 -%}
          {%- when 4 -%}{%- assign pct = 20 -%}
          {%- else -%}{%- assign pct = 0 -%}
        {%- endcase -%}
        {%- comment -%}
          Shopify rekent de korting per stuk en rondt daarbij naar beneden af.
          Zelfde volgorde aanhouden, anders scheelt het hier een cent met de kassa.
        {%- endcomment -%}
        {%- assign bruto = eenheid | times: aantal -%}
        {%- assign af_stuk = eenheid | times: pct | divided_by: 100 -%}
        {%- assign af = af_stuk | times: aantal -%}
        {%- assign netto = bruto | minus: af -%}
        {%- comment -%}
          De stuksprijs staat groot en het totaal klein. Een dalende prijs per
          kaart leest als een aanbieding; een oplopend totaal leest als een
          hogere rekening, terwijl het om dezelfde getallen gaat.
        {%- endcomment -%}
        {%- assign per_stuk = eenheid | minus: af_stuk -%}
        <button type="button" class="tk3-trede" data-tk3-trede="{{ aantal }}"
          aria-label="{{ aantal }} kaarten kiezen{% if pct > 0 %}, {{ pct }} procent korting{% endif %}, {{ per_stuk | money }} per kaart">
          <span class="tk3-trede-aantal"><b>{% if aantal == 4 %}4+{% else %}{{ aantal }}{% endif %}</b> {% if aantal == 1 %}kaart{% else %}kaarten{% endif %}</span>
          <span class="tk3-trede-stuk">{{ per_stuk | money }}</span>
          <span class="tk3-trede-eenheid">per kaart</span>
          <span class="tk3-trede-pct">{% if pct > 0 %}−{{ pct }}%{% else %}basisprijs{% endif %}</span>
          <span class="tk3-trede-prijs">totaal {{ netto | money }}</span>
        </button>
      {%- endfor -%}
    </div>
    <small>Wordt automatisch verrekend in de winkelwagen — je hoeft geen code in te vullen. Geldt over alle TapKaarten samen, ook als je verschillende soorten kiest. <a href="/pages/offerte">Meer dan tien kaarten nodig?</a></small>
  </div>

  {%- comment -%}
    Hier stond eerst een invulveld voor de link. Dat is eruit: het koppelen
    loopt nu via het formulier dat na de bestelling gemaild wordt, en twee
    kanalen voor dezelfde informatie leverden alleen maar een extra handeling
    op de plek waar die het duurst is. Wat blijft is de geruststelling.
  {%- endcomment -%}
  <div class="tk3-koppelmelding">
    <span class="tk3-koppelmelding-icoon" aria-hidden="true">✓</span>
    <span>
      <b>Wij koppelen je pagina voor je.</b>
      Na je bestelling vul je een kort formulier in met je bedrijfsnaam en plaats — wij zoeken je
      Google-, Instagram- of Facebookpagina op en zetten die erop.
      <a href="/pages/koppelen">Zo werkt dat</a>
    </span>
  </div>

  <button
    type="submit"
    name="add"
    class="button button--primary product-info__add"
    {% unless current_variant.available %}
      disabled
    {% endunless %}
    data-add-to-cart
  >
    <span data-add-to-cart-label>
      {% if current_variant.available %}
        {{ 'product.add_to_cart' | t }}
      {% else %}
        {{ 'product.sold_out' | t }}
      {% endif %}
    </span>
  </button>

  <div
    class="product-info__add-error"
    data-add-to-cart-error
    data-generic-error="{{ 'cart.add_error' | t }}"
    role="alert"
    hidden
  ></div>

  <div class="product-info__payment-terms">
    {{ form | payment_terms }}
  </div>
</div>

<script>
  // Klikken op een staffeltrede vult het aantal in en markeert welke trede je krijgt.
  (function () {
    if (window.tk3StaffelGeregeld) return;
    window.tk3StaffelGeregeld = true;

    var aantalVeld = function (el) {
      var form = el.closest('form');
      return (form || document).querySelector('input[name="quantity"]');
    };

    var markeer = function () {
      document.querySelectorAll('[data-tk3-staffel]').forEach(function (blok) {
        var veld = aantalVeld(blok);
        var nu = veld ? parseInt(veld.value, 10) || 1 : 1;
        blok.querySelectorAll('[data-tk3-trede]').forEach(function (trede) {
          var n = parseInt(trede.getAttribute('data-tk3-trede'), 10);
          // de hoogste trede die je al haalt, is de trede die je krijgt
          var actief = nu >= n && (n === 4 || nu < n + 1);
          trede.classList.toggle('is-actief', actief);
        });
      });
    };

    document.addEventListener('click', function (e) {
      var trede = e.target && e.target.closest && e.target.closest('[data-tk3-trede]');
      if (!trede) return;
      var veld = aantalVeld(trede);
      if (!veld) return;
      veld.value = trede.getAttribute('data-tk3-trede');
      veld.dispatchEvent(new Event('input', { bubbles: true }));
      veld.dispatchEvent(new Event('change', { bubbles: true }));
      markeer();
    });
    document.addEventListener('input', function (e) {
      if (e.target && e.target.name === 'quantity') markeer();
    });
    document.addEventListener('change', function (e) {
      if (e.target && e.target.name === 'quantity') markeer();
    });
    markeer();
  })();
</script>
