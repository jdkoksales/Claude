{{ 'tk3.css' | asset_url | stylesheet_tag }}

{%- assign rail_id = 'tk3-kl-' | append: section.id -%}

{%- comment -%}
  Klantverhalen als carousel.

  Een grote foto per kaart, in de verhouding van een telefoonfoto. De bedoeling
  is dat het eruitziet alsof de ondernemer zelf een kiekje heeft opgestuurd met
  zijn kaartje erbij — dat overtuigt hier meer dan een strak portret.

  De uitkomst staat boven de quote omdat wie scrolt alleen die regel leest.
{%- endcomment -%}

<div class="tk3">
  <section class="blk klanten">
    <div class="wrap">
      <h2 class="sec-title center">{{ section.settings.heading }}</h2>
      {%- if section.settings.sub != blank -%}
        <p class="sec-sub center">{{ section.settings.sub }}</p>
      {%- endif -%}

      {%- if section.settings.voorbeeld -%}
        <p class="kl-let-op">Voorbeeldinhoud — vervangen voordat deze pagina live gaat.</p>
      {%- endif -%}

      <div class="rail kl-rail" id="{{ rail_id }}">
        {%- for block in section.blocks -%}
          <figure class="kl-kaart" {{ block.shopify_attributes }}>
            {%- if block.settings.foto -%}
              <div class="kl-foto">
                {{
                  block.settings.foto
                  | image_url: width: 760
                  | image_tag: loading: 'lazy', alt: block.settings.naam, widths: '380,570,760'
                }}
              </div>
            {%- endif -%}

            {%- if block.settings.sterren > 0 -%}
              <div class="kl-sterren" aria-label="{{ block.settings.sterren }} van 5 sterren">
                {%- for i in (1..block.settings.sterren) -%}★{%- endfor -%}
              </div>
            {%- endif -%}

            {%- if block.settings.resultaat != blank -%}
              <p class="kl-resultaat">
                <span class="kl-cijfer">{{ block.settings.resultaat }}</span>
                {%- if block.settings.periode != blank -%}
                  <span class="kl-periode">{{ block.settings.periode }}</span>
                {%- endif -%}
              </p>
            {%- endif -%}

            <blockquote>{{ block.settings.quote }}</blockquote>

            <figcaption class="kl-wie">
              <span class="kl-wie-tekst">
                <b>{{ block.settings.naam }}</b>
                {%- if block.settings.zaak != blank -%}
                  <span>{{ block.settings.zaak }}</span>
                {%- endif -%}
              </span>
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>

      <div class="arrows">
        <button type="button" onclick="tk3ScrollRail('{{ rail_id }}',-1)" aria-label="Vorige">←</button>
        <button type="button" onclick="tk3ScrollRail('{{ rail_id }}',1)" aria-label="Volgende">→</button>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "TK3 klantverhalen",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Wat het bij hen deed." },
    { "type": "textarea", "id": "sub", "label": "Onderkop", "default": "Ondernemers die een TapKaart op de balie hebben staan." },
    {
      "type": "checkbox",
      "id": "voorbeeld",
      "label": "Waarschuwing tonen dat dit voorbeeldinhoud is",
      "default": true,
      "info": "Zet dit uit zodra je echte klantverhalen met toestemming hebt ingevuld."
    }
  ],
  "max_blocks": 16,
  "blocks": [
    {
      "type": "klant",
      "name": "Klantverhaal",
      "settings": [
        { "type": "image_picker", "id": "foto", "label": "Foto" },
        { "type": "range", "id": "sterren", "label": "Sterren", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "resultaat", "label": "Uitkomst", "info": "Bijvoorbeeld: van 165 naar 540 volgers" },
        { "type": "text", "id": "periode", "label": "In hoeveel tijd", "info": "Bijvoorbeeld: in 2 maanden" },
        { "type": "textarea", "id": "quote", "label": "Wat ze zegt" },
        { "type": "text", "id": "naam", "label": "Naam" },
        { "type": "text", "id": "zaak", "label": "Zaak en plaats" }
      ]
    }
  ],
  "presets": [{ "name": "TK3 klantverhalen" }]
}
{% endschema %}
