{{ 'tk3.css' | asset_url | stylesheet_tag }}

{%- assign rail_id = 'tk3-rev-' | append: section.id -%}

<div class="tk3">
  <section class="blk">
    <div class="wrap">
      <h2 class="sec-title center">{{ section.settings.heading }}</h2>
      {%- if section.settings.sub != blank -%}
        <p class="sec-sub center" style="margin-bottom:44px">{{ section.settings.sub }}</p>
      {%- endif -%}

      <div class="rail" id="{{ rail_id }}">
        {%- for block in section.blocks -%}
          <div class="revcard" {{ block.shopify_attributes }}>
            <div class="stars">{% for i in (1..block.settings.stars) %}★{% endfor %}</div>
            <p>{{ block.settings.text }}</p>
            <div class="src">{{ block.settings.source }}</div>
          </div>
        {%- endfor -%}
      </div>

      <div class="arrows">
        <button type="button" onclick="tk3ScrollRail('{{ rail_id }}',-1)" aria-label="Vorige">←</button>
        <button type="button" onclick="tk3ScrollRail('{{ rail_id }}',1)" aria-label="Volgende">→</button>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "TK3 reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Wat ondernemers zeggen." },
    { "type": "textarea", "id": "sub", "label": "Onderkop", "default": "Echte reacties verschijnen hier zodra je eerste klanten geleverd zijn." }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "min": 1, "max": 5, "step": 1, "label": "Sterren", "default": 5 },
        { "type": "textarea", "id": "text", "label": "Tekst", "default": "[PLAATSHOUDER — echte klantreactie]" },
        { "type": "text", "id": "source", "label": "Bron", "default": "Zaaknaam — datum" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TK3 reviews",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}
