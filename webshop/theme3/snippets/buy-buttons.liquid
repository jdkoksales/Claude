<div class="product-info__buy-buttons" data-buy-buttons>
  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

  {%- comment -%}
    Staffelkorting. De percentages hieronder moeten gelijk lopen met de drie
    automatische kortingen in Shopify; die doen het echte rekenwerk in de
    winkelwagen. Klikken op een trede vult het aantal alvast in.
  {%- endcomment -%}
  {%- assign eenheid = current_variant.price -%}
  <div class="tk3-staffel" data-tk3-staffel>
    <div class="tk3-staffel-kop">Meer kaarten, meer korting</div>
    <div class="tk3-staffel-rij">
      {%- assign treden = '1,2,3,4' | split: ',' -%}
      {%- for trede in treden -%}
        {%- assign aantal = trede | plus: 0 -%}
        {%- case aantal -%}
          {%- when 2 -%}{%- assign pct = 10 -%}
          {%- when 3 -%}{%- assign pct = 15 -%}
          {%- when 4 -%}{%- assign pct = 20 -%}
          {%- else -%}{%- assign pct = 0 -%}
        {%- endcase -%}
        {%- assign bruto = eenheid | times: aantal -%}
        {%- assign af = bruto | times: pct | divided_by: 100 -%}
        {%- assign netto = bruto | minus: af -%}
        <button type="button" class="tk3-trede" data-tk3-trede="{{ aantal }}"
          aria-label="{{ aantal }} kaarten kiezen{% if pct > 0 %}, {{ pct }} procent korting{% endif %}">
          <span class="tk3-trede-aantal">{{ aantal }}{% if aantal == 4 %}+{% endif %} {% if aantal == 1 %}kaart{% else %}kaarten{% endif %}</span>
          <span class="tk3-trede-pct">{% if pct > 0 %}−{{ pct }}%{% else %}basis{% endif %}</span>
          <span class="tk3-trede-prijs">{{ netto | money }}</span>
        </button>
      {%- endfor -%}
    </div>
    <small>Wordt automatisch verrekend in de winkelwagen — je hoeft geen code in te vullen. Geldt over alle TapKaarten samen, ook als je verschillende soorten kiest.</small>
  </div>

  {%- comment -%}
    Zonder dit veld weet de winkel na een bestelling niet welke pagina de kaart
    moet openen en moet er alsnog gemaild worden. Het is bewust optioneel: wie
    het overslaat krijgt gewoon een mailtje.
  {%- endcomment -%}
  <div class="tk3-linkveld">
    <label for="tk3-link-{{ current_variant.id }}">Welke pagina moet de kaart openen?</label>
    <input
      type="url"
      id="tk3-link-{{ current_variant.id }}"
      name="properties[Link voor de kaart]"
      placeholder="https://g.page/r/... of je Instagram-profiel"
      autocomplete="url"
      spellcheck="false"
      data-tk3-linkveld
    >
    <small>Optioneel. Weet je de link nog niet? Laat het leeg — we mailen je na je bestelling. Je kunt de kaart later ook zelf herprogrammeren.</small>
  </div>

  <button
    type="submit"
    name="add"
    class="button button--primary product-info__add"
    {% unless current_variant.available %}
      disabled
    {% endunless %}
    data-add-to-cart
  >
    <span data-add-to-cart-label>
      {% if current_variant.available %}
        {{ 'product.add_to_cart' | t }}
      {% else %}
        {{ 'product.sold_out' | t }}
      {% endif %}
    </span>
  </button>

  <div
    class="product-info__add-error"
    data-add-to-cart-error
    data-generic-error="{{ 'cart.add_error' | t }}"
    role="alert"
    hidden
  ></div>

  <div class="product-info__payment-terms">
    {{ form | payment_terms }}
  </div>
</div>

<script>
  // Een leeg veld mag niet als lege regel op de bestelling belanden. Uitgeschakelde
  // velden worden niet meegestuurd, maar het veld moet wél te typen blijven — dus
  // zetten we het pas op het laatste moment uit, in de capture-fase op document,
  // zodat dit vóór de winkelwagencode van het thema gebeurt.
  (function () {
    if (window.tk3LinkveldGeregeld) return;
    window.tk3LinkveldGeregeld = true;

    var leegUit = function () {
      var uit = [];
      document.querySelectorAll('[data-tk3-linkveld]').forEach(function (veld) {
        if (!veld.disabled && veld.value.trim() === '') {
          veld.disabled = true;
          uit.push(veld);
        }
      });
      // meteen weer aanzetten zodra de bestelling verstuurd is
      if (uit.length) {
        setTimeout(function () {
          uit.forEach(function (veld) { veld.disabled = false; });
        }, 0);
      }
    };

    // Klikken op een trede vult het aantal in en markeert de actieve trede.
    var aantalVeld = function (el) {
      var form = el.closest('form');
      return (form || document).querySelector('input[name="quantity"]');
    };

    var markeer = function () {
      document.querySelectorAll('[data-tk3-staffel]').forEach(function (blok) {
        var veld = aantalVeld(blok);
        var nu = veld ? parseInt(veld.value, 10) || 1 : 1;
        blok.querySelectorAll('[data-tk3-trede]').forEach(function (trede) {
          var n = parseInt(trede.getAttribute('data-tk3-trede'), 10);
          // de hoogste trede die je al haalt, is de trede die je krijgt
          var actief = nu >= n && (n === 4 || nu < n + 1);
          trede.classList.toggle('is-actief', actief);
        });
      });
    };

    document.addEventListener('click', function (e) {
      var trede = e.target && e.target.closest && e.target.closest('[data-tk3-trede]');
      if (!trede) return;
      var veld = aantalVeld(trede);
      if (!veld) return;
      veld.value = trede.getAttribute('data-tk3-trede');
      veld.dispatchEvent(new Event('input', { bubbles: true }));
      veld.dispatchEvent(new Event('change', { bubbles: true }));
      markeer();
    });
    document.addEventListener('input', function (e) {
      if (e.target && e.target.name === 'quantity') markeer();
    });
    document.addEventListener('change', function (e) {
      if (e.target && e.target.name === 'quantity') markeer();
    });
    markeer();

    document.addEventListener('submit', leegUit, true);
    document.addEventListener(
      'click',
      function (e) {
        var knop = e.target && e.target.closest && e.target.closest('[data-add-to-cart]');
        if (knop) leegUit();
      },
      true
    );
  })();
</script>
