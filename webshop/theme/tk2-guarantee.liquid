<section class="tk2 block">
  <div class="wrap">
    <div class="guarantee">
      <div>
        {% if section.settings.eyebrow != blank %}<div class="eyebrow" style="margin-bottom:10px">{{ section.settings.eyebrow }}</div>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
        <p class="gtext">{{ section.settings.text }}</p>
        <div class="pays">
          {% assign methods = section.settings.payments | split: ',' %}
          {% for m in methods %}<span class="pay">{{ m | strip }}</span>{% endfor %}
        </div>
      </div>
      <div class="g-visual">
        <div class="shield"><svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></div>
        <b>{{ section.settings.visual_title }}</b>
        <p class="gsub">{{ section.settings.visual_sub }}</p>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TK Garantie",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Zonder risico proberen" },
    { "type": "inline_richtext", "id": "heading", "label": "Kop", "default": "14 dagen bedenktijd.<br>Niet goed? Geld terug." },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Bestel vandaag, probeer hem twee weken op je balie. Bevalt het niet — om welke reden dan ook — dan stuur je hem terug en krijg je alles terug." },
    { "type": "text", "id": "payments", "label": "Betaalmethodes (komma-gescheiden)", "default": "iDEAL, Apple Pay, Klarna, Visa, Mastercard, PayPal" },
    { "type": "text", "id": "visual_title", "label": "Titel rechts", "default": "Veilig betalen & snel in huis" },
    { "type": "text", "id": "visual_sub", "label": "Subtekst rechts", "default": "Verzonden met PostNL, netjes verpakt." }
  ],
  "presets": [ { "name": "TK Garantie" } ]
}
{% endschema %}
