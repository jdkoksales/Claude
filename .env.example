# --- Slack ---
# Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-Level Token for Socket Mode (starts with xapp-), needs connections:write
SLACK_APP_TOKEN=xapp-your-app-token
# Optional, only needed for HTTP mode instead of Socket Mode
SLACK_SIGNING_SECRET=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-your-key
# Default is a good speed/cost balance; use claude-opus-4-8 for max capability
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024

# --- Persona ---
# Defines how the "employee" behaves. Leave empty to use the built-in default.
CLAUDE_PERSONA=
