{{ 'tk3.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign uid = 'tk3calc-' | append: section.id
-%}

<div class="tk3">
  <section class="blk grey calc" id="calculator">
    <div class="wrap">
      <h2 class="sec-title center">{{ section.settings.heading }}</h2>
      {%- if section.settings.sub != blank -%}
        <p class="sec-sub center" style="margin-bottom:42px">{{ section.settings.sub }}</p>
      {%- endif -%}

      <div class="shell"
        data-tk3-calc
        data-share="{{ section.settings.checkout_share }}"
        data-google="{{ section.settings.rate_google }}"
        data-instagram="{{ section.settings.rate_instagram }}"
        data-facebook="{{ section.settings.rate_facebook }}">

        <div class="block">
          <div class="step">Stap 1</div>
          <div class="q">{{ section.settings.q1 }}</div>
          <div class="picks" role="group">
            <button type="button" class="pick" data-kind="google" aria-pressed="true"
              data-accent="#4285F4" data-label="{{ section.settings.label_google | escape }}">
              <span class="ico">
                <svg width="21" height="21" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6z"/><path fill="#34A853" d="M12 23.5c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3a11.5 11.5 0 0 0 10.2 6.3z"/><path fill="#FBBC05" d="M5.6 14.2a6.9 6.9 0 0 1 0-4.4v-3H1.8a11.5 11.5 0 0 0 0 10.4l3.8-3z"/><path fill="#EA4335" d="M12 5.1c1.7 0 3.2.6 4.4 1.7l3.3-3.3A11.5 11.5 0 0 0 1.8 6.8l3.8 3c.9-2.7 3.4-4.7 6.4-4.7z"/></svg>
              </span>
              <span class="nm">Google Reviews</span>
            </button>

            <button type="button" class="pick" data-kind="instagram" aria-pressed="false"
              data-accent="#D62976" data-label="{{ section.settings.label_instagram | escape }}">
              <span class="ico">
                <svg width="21" height="21" viewBox="0 0 24 24" aria-hidden="true">
                  <defs><linearGradient id="{{ uid }}-ig" x1="0" y1="1" x2="1" y2="0">
                    <stop offset="0" stop-color="#FEDA75"/><stop offset=".28" stop-color="#FA7E1E"/>
                    <stop offset=".6" stop-color="#D62976"/><stop offset=".85" stop-color="#962FBF"/>
                    <stop offset="1" stop-color="#4F5BD5"/></linearGradient></defs>
                  <rect x="2" y="2" width="20" height="20" rx="6" fill="url(#{{ uid }}-ig)"/>
                  <circle cx="12" cy="12" r="4.4" fill="none" stroke="#fff" stroke-width="1.9"/>
                  <circle cx="17.4" cy="6.6" r="1.25" fill="#fff"/>
                </svg>
              </span>
              <span class="nm">Instagram volgers</span>
            </button>

            <button type="button" class="pick" data-kind="facebook" aria-pressed="false"
              data-accent="#1877F2" data-label="{{ section.settings.label_facebook | escape }}">
              <span class="ico">
                <svg width="21" height="21" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" fill="#1877F2"/>
                  <path fill="#fff" d="M15.6 15.1 16 12h-3v-2c0-.9.4-1.7 1.8-1.7H16V5.6s-1.2-.2-2.3-.2c-2.4 0-3.9 1.4-3.9 4V12H7v3.1h2.8V22a10 10 0 0 0 3.2 0v-6.9h2.6z"/>
                </svg>
              </span>
              <span class="nm">Facebook volgers</span>
            </button>
          </div>
        </div>

        <div class="block">
          <div class="step">Stap 2</div>
          <div class="q">{{ section.settings.q2 }}</div>
          <div class="bignum"><span data-visitors>12.400</span><small>bezoekers per maand</small></div>
          <input type="range" min="100" max="50000" step="100" value="12400"
            aria-label="{{ section.settings.q2 | escape }}" data-slider>
          <div class="ends"><span>100</span><span>50.000</span></div>
        </div>

        <div class="out" data-out>
          <div class="lbl" data-outlabel>{{ section.settings.label_google }}</div>
          <div class="val" data-value>+198</div>
          <div class="note">{{ section.settings.note }}</div>
          <div class="split">
            <div><div class="k">Per week</div><div class="v" data-week>≈ 46</div></div>
            <div><div class="k">Per dag</div><div class="v" data-day>≈ 6,5</div></div>
          </div>
        </div>

        <div class="cta">
          <h3>{{ section.settings.cta_heading }}</h3>
          <p>{{ section.settings.cta_text }}</p>
          <a class="btn-primary" href="{{ section.settings.cta_url | default: '#producten' }}">{{ section.settings.cta_button }}</a>
        </div>

        <p class="fine">{{ section.settings.disclaimer }}</p>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "TK3 calculator",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Bekijk wat een Tapkaart jou oplevert" },
    { "type": "textarea", "id": "sub", "label": "Onderkop", "default": "Bereken binnen enkele seconden hoeveel extra Google Reviews of social media volgers jouw winkel kan verzamelen." },
    { "type": "text", "id": "q1", "label": "Vraag 1", "default": "Welke Tapkaart wil je gebruiken?" },
    { "type": "text", "id": "q2", "label": "Vraag 2", "default": "Hoeveel bezoekers ontvangt jouw winkel per maand?" },
    { "type": "header", "content": "Rekenwaarden" },
    { "type": "text", "id": "checkout_share", "label": "Deel dat langs de kassa komt", "default": "0.80" },
    { "type": "text", "id": "rate_google", "label": "Conversie Google", "default": "0.02" },
    { "type": "text", "id": "rate_instagram", "label": "Conversie Instagram", "default": "0.03" },
    { "type": "text", "id": "rate_facebook", "label": "Conversie Facebook", "default": "0.015" },
    { "type": "header", "content": "Teksten bij het resultaat" },
    { "type": "text", "id": "label_google", "label": "Label Google", "default": "Geschat aantal nieuwe reviews per maand" },
    { "type": "text", "id": "label_instagram", "label": "Label Instagram", "default": "Geschat aantal nieuwe Instagram-volgers per maand" },
    { "type": "text", "id": "label_facebook", "label": "Label Facebook", "default": "Geschat aantal nieuwe Facebook-volgers per maand" },
    { "type": "text", "id": "note", "label": "Ondertitel bij het getal", "default": "Realistische schatting" },
    { "type": "header", "content": "Oproep tot actie" },
    { "type": "text", "id": "cta_heading", "label": "Kop", "default": "Klaar om meer klanten te overtuigen?" },
    { "type": "textarea", "id": "cta_text", "label": "Tekst", "default": "Een Tapkaart maakt het voor klanten eenvoudig om direct een review achter te laten of jouw bedrijf te volgen." },
    { "type": "text", "id": "cta_button", "label": "Knop", "default": "Bestel jouw Tapkaart" },
    { "type": "url", "id": "cta_url", "label": "Knoplink" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "De berekening is een indicatieve schatting op basis van gemiddelde conversiepercentages." }
  ],
  "presets": [{ "name": "TK3 calculator" }]
}
{% endschema %}
