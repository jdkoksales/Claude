{{ 'tk3.css' | asset_url | stylesheet_tag }}

<div class="tk3">
  <section class="hero">
    <div class="inner">
      <div class="wrap">
        <h1>{{ section.settings.heading }}</h1>
        {%- if section.settings.sub != blank -%}
          <p class="sub">{{ section.settings.sub }}</p>
        {%- endif -%}

        <div class="hearts"><i>❤️</i><i>❤️</i></div>

        <div class="controls">
          <div class="seg" role="tablist" aria-label="Platform">
            <button role="tab" aria-selected="true" title="Google">
              <svg width="19" height="19" viewBox="0 0 24 24"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6z"/><path fill="#34A853" d="M12 23.5c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3a11.5 11.5 0 0 0 10.2 6.3z"/><path fill="#FBBC05" d="M5.6 14.2a6.9 6.9 0 0 1 0-4.4v-3H1.8a11.5 11.5 0 0 0 0 10.4l3.8-3z"/><path fill="#EA4335" d="M12 5.1c1.7 0 3.2.6 4.4 1.7l3.3-3.3A11.5 11.5 0 0 0 1.8 6.8l3.8 3c.9-2.7 3.4-4.7 6.4-4.7z"/></svg>
            </button>
            <button role="tab" aria-selected="false" title="Instagram">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
            </button>
            <button role="tab" aria-selected="false" title="Facebook">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z"/></svg>
            </button>
            <button role="tab" aria-selected="false" title="Sticker">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="3 2.6"><rect x="3.5" y="3.5" width="17" height="17" rx="4"/></svg>
            </button>
          </div>

          <div class="seg tabs" role="tablist" aria-label="Uitvoering">
            <button role="tab" aria-selected="true">Wit</button>
            <button role="tab" aria-selected="false">Zwart</button>
          </div>

          <a class="buy" href="{{ section.settings.cta_url | default: '#producten' }}">{{ section.settings.cta_text }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>

      {%- if section.settings.image -%}
        <img class="shot" src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.image.alt | escape }}" width="2000" height="849">
      {%- else -%}
        <img class="shot" src="{{ 'tk3-hero.jpg' | file_url }}" alt="{{ section.settings.heading | escape }}" width="1584" height="672">
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "TK3 hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Verander bezoekers in reviews." },
    { "type": "textarea", "id": "sub", "label": "Onderkop", "default": "Eén tik met de telefoon en je klant staat op jouw reviewpagina. Het vraagt erom terwijl jij gewoon werkt." },
    { "type": "text", "id": "cta_text", "label": "Knop", "default": "Kopen" },
    { "type": "url", "id": "cta_url", "label": "Knoplink" },
    { "type": "image_picker", "id": "image", "label": "Hero-afbeelding (leeg = ingebouwd)" }
  ],
  "presets": [{ "name": "TK3 hero" }]
}
{% endschema %}
