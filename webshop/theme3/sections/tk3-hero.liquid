{{ 'tk3.css' | asset_url | stylesheet_tag }}

<div class="tk3">
  <section class="hero">
    <div class="inner">
      <div class="wrap">
        <h1>{{ section.settings.heading }}</h1>
        {%- if section.settings.sub != blank -%}
          <p class="sub">{{ section.settings.sub }}</p>
        {%- endif -%}

        <div class="controls">
          {%- comment -%}
            Eén knop, geen platformkiezer meer. Die kiezer wisselde alleen het
            product achter de knop; in de hero las hij als drie logo's waar je
            iets mee moest doen, terwijl er maar één ding te doen is. Kiezen
            tussen Google, Instagram en Facebook gebeurt verderop, bij de
            producten zelf.
          {%- endcomment -%}
          <a class="buy" href="{{ section.settings.cta_url | default: '#producten' }}">{{ section.settings.cta_text | default: 'Bestel nu!' }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>

        {%- comment -%}
          Tweede, zachtere ingang: wie nog niet wil kopen maar wel wil weten
          wat het oplevert, gaat naar de rekenhulp. Bewust een link en geen
          knop, zodat hij niet met Kopen concurreert.
        {%- endcomment -%}
        {%- if section.settings.calc_text != blank -%}
          <a class="hero-calc" href="{{ section.settings.calc_url | default: '#calculator' }}">
            <span>{{ section.settings.calc_text }}</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
          </a>
        {%- endif -%}
      </div>

      {%- comment -%}
        Eén foto per schermgrootte in plaats van drie wisselende productplaatjes.
        De oranje achtergrond zit in de foto zelf, dus hij vult de hele sectie
        en de tekst ligt eroverheen. Art direction, geen uitsnede: een telefoon
        haalt de staande versie op en niet het brede desktopbeeld.

        De telefoonversie is een krappe uitsnede om het bordje heen. De hoge
        versie had een halve foto lege lucht boven de standaard, en op een
        telefoon met browserbalk bleef er zo weinig hoogte over dat object-fit
        precies die lucht liet staan en het bordje wegsneed.
      {%- endcomment -%}
      <picture class="hero-foto">
        <source media="(max-width: 599px)" srcset="{{ 'tk3-hero-telefoon-krap.jpg' | asset_url }}" width="900" height="900">
        <source media="(max-width: 1023px)" srcset="{{ 'tk3-hero-tablet-krap.jpg' | asset_url }}" width="1400" height="745">
        <img src="{{ 'tk3-hero-ai-desktop.jpg' | asset_url }}" width="1800" height="1005"
          alt="{{ section.settings.foto_alt | default: 'Een TapKaarten Google Review-standaard op een balie' }}"
          fetchpriority="high" decoding="async">
      </picture>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "TK3 hero",
  "settings": [
    { "type": "text", "id": "foto_alt", "label": "Omschrijving van de foto", "info": "Voor schermlezers en voor Google." },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Je beste marketing staat op de balie." },
    { "type": "textarea", "id": "sub", "label": "Onderkop", "info": "Kort houden: op een telefoon gaat elke regel hier af van de ruimte voor de foto.", "default": "Eén tik en je klant staat op jouw reviewpagina. Jij hoeft niets te vragen." },
    { "type": "text", "id": "cta_text", "label": "Knop", "default": "Bestel nu!" },
    { "type": "url", "id": "cta_url", "label": "Knoplink" },
    { "type": "text", "id": "calc_text", "label": "Tweede regel onder de knop", "default": "Bereken wat TapKaarten jou oplevert." },
    { "type": "url", "id": "calc_url", "label": "Link van die regel" }
  ],
  "presets": [{ "name": "TK3 hero" }]
}
{% endschema %}
