<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  comment
    De voorpagina erft alleen de winkelnaam. Dat is een lege plek in Google en
    op WhatsApp, dus geven we haar hier een eigen titel en omschrijving.
  endcomment
  assign home_title = 'TapKaarten — NFC-bordjes voor meer Google-reviews en volgers'
  assign home_description = 'Zet een TapKaart op je balie: één tik met de telefoon en je klant staat op jouw Google-, Instagram- of Facebookpagina. Geen app, geen abonnement, € 39,95.'
  if request.page_type == 'index'
    if page_title == blank or page_title == shop.name
      assign og_title = home_title
    endif
    if page_description == blank
      assign og_description = home_description
    endif
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- comment -%}
  Zonder afbeelding valt een gedeelde link op WhatsApp of Facebook terug op een
  leeg vlak. Heeft de pagina zelf geen beeld, dan gebruiken we de merkkaart.
{%- endcomment -%}
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
  <meta name="twitter:image" content="https:{{ page_image | image_url }}">
{%- else -%}
  {%- assign fallback_image = 'tk3-social.jpg' | asset_url | prepend: request.origin -%}
  <meta property="og:image" content="{{ fallback_image }}">
  <meta property="og:image:secure_url" content="{{ fallback_image }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="TapKaarten — NFC-kaarten voor meer reviews en volgers">
  <meta name="twitter:image" content="{{ fallback_image }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- comment -%}
  Wie de winkel is, waar hij staat en hoe je hem bereikt — zodat Google de
  gegevens uit de voettekst ook echt als bedrijfsgegevens herkent.
{%- endcomment -%}
{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "OnlineStore",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "logo": {{ 'tk3-social.jpg' | asset_url | prepend: request.origin | json }},
      "email": {{ shop.email | json }},
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ shop.address.street | json }},
        "postalCode": {{ shop.address.zip | json }},
        "addressLocality": {{ shop.address.city | json }},
        "addressCountry": {{ shop.address.country_upper | json }}
      }
    }
  </script>
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

<title>
  {%- if request.page_type == 'index' -%}{{ og_title }}{%- else -%}{{ page_title }}{%- endif -%}
  {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} &ndash; pagina {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link rel="canonical" href="{{ canonical_url }}">

{% if page_description != blank %}
  <meta name="description" content="{{ page_description | escape }}">
{% elsif request.page_type == 'index' %}
  <meta name="description" content="{{ home_description | escape }}">
{% endif %}
